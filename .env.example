# LOCAL ONLY: copy to .env.local; set a password of at least 12 characters.
MDART_LOCAL_DATA=1
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Vercel: omit MDART_LOCAL_DATA. Create separate private/public Blob stores.
# Private store: BLOB_STORE_ID is added by the Vercel integration.
# VERCEL_OIDC_TOKEN is managed by Vercel at runtime; do not set it manually.
BLOB_STORE_ID=
# Optional fallback for private storage without OIDC.
BLOB_READ_WRITE_TOKEN=
# Public image uploads currently require the public store's read-write token.
BLOB_PUBLIC_READ_WRITE_TOKEN=
# Optional analytics: server-only token, scoped to the relevant project/team.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=
ANALYTICS_CUSTOM_EVENTS=0
# Optional canonical origin (omit to accept current deployment's origin).
APP_ORIGIN=
